# Ezan Vakfı Sayti (apps/ezan-web) — Environment Variables (.env.example)
# Hech qanday haqiqiy kalit git'ga qo'shilmasin!

NODE_ENV=development
PORT=3005

# Alohida PostgreSQL bazasi (ichki vaqf bazasiga ulanmaydi!)
DATABASE_URL=postgresql://ezan_user:ezan_local_pass@127.0.0.1:5437/ezan_web
POSTGRES_USER=ezan_user
POSTGRES_PASSWORD=
POSTGRES_DB=ezan_web

# 2860-qonun bo'yicha ruxsat: false bo'lsa saytda "Sinov rejimi" ko'rinadi va sandbox ishlaydi
DONATIONS_LIVE=false

# To'lov provayderi: mock | iyzico | paytr | param
PAYMENT_PROVIDER=mock
IYZICO_SANDBOX_API_KEY=
IYZICO_SANDBOX_SECRET_KEY=
IYZICO_LIVE_API_KEY=
IYZICO_SECRET_KEY=
SANDBOX_WEBHOOK_SECRET=

# Domenlar allowlist'i
SITE_HOSTS=ezanvakfi.org,azonvaqfi.org,localhost:3005,127.0.0.1:3005

# Lokal sinov uchun (faqat NODE_ENV=development da ishlaydi)
DEV_FAKE_COUNTRY=
DEV_FAKE_HOST=

# Ichki Vaqf tizimi (Mezana) bilan HMAC-SHA256 sinxronlash siri
EZAN_SYNC_SECRET=

# Admin panel (/admin) himoyasi va Payload siri
PAYLOAD_SECRET=
ADMIN_ALLOWED_IPS=127.0.0.1,::1,192.168.1.10
ADMIN_REQUIRE_CF_ACCESS=false

# Cloudflare Turnstile (Aloqa, Xabar berish, Obuna formalari uchun)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SMTP (Bağış Alındı Belgesi PDF yuborish uchun; bo'sh bo'lsa outbox navbatida qoladi)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=bilgi@ezanvakfi.org

# Kuzatuv va Analitika (Cookie roziligidan keyin yuklanadi)
SENTRY_DSN=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA4_ID=