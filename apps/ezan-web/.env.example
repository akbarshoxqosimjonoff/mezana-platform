NODE_ENV=production
DATABASE_URL=
DONATIONS_LIVE=false
PAYMENT_PROVIDER=mock
RECURRING_ENABLED=false
SITE_HOSTS=ezanvakfi.org,www.ezanvakfi.org,azonvaqfi.org,www.azonvaqfi.org

# Secrets (generate with: openssl rand -hex 32 ; minimum 32 chars required at startup)
EZAN_SYNC_SECRET=
PAYMENT_WEBHOOK_SECRET=
SANDBOX_WEBHOOK_SECRET=
WEBHOOK_SECRET=
ADMIN_SESSION_SECRET=

# iyzico Checkout Form credentials (required when PAYMENT_PROVIDER=iyzico)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Cloudflare Turnstile (required in production)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Admin Network & Cloudflare Access
ADMIN_ALLOWED_IPS=
ADMIN_REQUIRE_CF_ACCESS=false
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Phase 2: SMS (Netgsm | mock) & WhatsApp Business Cloud API
SMS_PROVIDER=mock
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=EZANVAKFI
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Phase 2: S3 / Cloudflare R2 / MinIO Video Storage & FFmpeg Worker
S3_ENDPOINT=
S3_BUCKET=ezan-kurban-videos
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
FFMPEG_WORKER_CONCURRENCY=2
SENTRY_DSN=
