# Mezana Finance & Vaqf BFF Server Configuration
FINANCE_PORT=3000
FINANCE_ALT_PORT=8005

# Database Connections (Required ? no default passwords in code)
PLATFORM_DB_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/mezana_platform"
CRM_DB_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/mezana"
ERP_DB_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/moliy_db"

# Internal Service Endpoints
CRM_GRAPHQL_URL="http://127.0.0.1:4000/graphql"
ERP_API_URL="http://127.0.0.1:3004/api/v1"

# JWT Secrets (loaded from .env or service .env files)
CRM_JWT_SECRET="replace-with-crm-jwt-secret"
ERP_JWT_SECRET="replace-with-erp-jwt-secret"

# Optional Integrations
TELEGRAM_BOT_TOKEN=""
GATE_TELEGRAM_BOT_TOKEN=""
OPENAI_API_KEY=""
VAQF_STORAGE_DIR="/srv/data/vaqf"
